{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistates.dev/schemas/audit-result-v1.schema.json",
  "title": "Epistates audit result v1",
  "description": "Structural descriptor for epistates/audit-result/v1. validation_scope: structural_only. The normative validator is epistates.audit.validate_audit_result. review_evidence_digest is a PRE-RELEASE EXTENSION (Slice5) bridging audit-result to review-evidence; it is NOT version-compatible: a pre-Slice5 v1 validator rejects this field. The new validator still accepts pure H2 artifacts (without this field). Bidirectionally required with exactly one capture evidence; the Python validator is normative for this restriction. $id is an opaque identifier, never a URL to download.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "run_id", "attempt_id", "task_card_digest", "authority_binding", "observed_at", "state_before", "classification", "decision", "evidence"],
  "properties": {
    "schema": {"const": "epistates/audit-result/v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "task_card_digest": {"$ref": "#/$defs/digest"},
    "authority_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_id", "grant_digest", "decision_reference"],
      "properties": {
        "grant_id": {"$ref": "#/$defs/id"},
        "grant_digest": {"$ref": "#/$defs/digest"},
        "decision_reference": {"$ref": "#/$defs/id"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "state_before": {"const": "REVIEWING"},
    "classification": {"enum": ["OK", "PARCIAL", "BLOQ"]},
    "decision": {"enum": ["proceed", "fix-and-retry", "escalate"]},
    "review_evidence_digest": {"$ref": "#/$defs/digest", "description": "PRE-RELEASE EXTENSION (Slice5). The Python validator is normative for the bidirectional requirement with capture evidence."},
    "evidence": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "status", "digest"],
        "properties": {
          "evidence_id": {"enum": ["git_status", "diff_check", "unit_tests", "file_digest", "capture"]},
          "status": {"enum": ["pass", "fail", "missing"]},
          "digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "missing"}}}, "then": {"properties": {"digest": {"type": "null"}}}},
          {"if": {"properties": {"status": {"enum": ["pass", "fail"]}}}, "then": {"properties": {"digest": {"$ref": "#/$defs/digest"}}}}
        ]
      }
    }
  },
  "allOf": [
    {"comment": "Bridge bidirectionality (Slice5): review_evidence_digest requires exactly one capture evidence and vice versa. The Python validator is normative; this allOf expresses the portable shape."},
    {"if": {"required": ["review_evidence_digest"]}, "then": {"properties": {"evidence": {"contains": {"properties": {"evidence_id": {"const": "capture"}}}, "minContains": 1, "maxContains": 1}}}},
    {"if": {"properties": {"evidence": {"contains": {"properties": {"evidence_id": {"const": "capture"}}}}}}, "then": {"required": ["review_evidence_digest"]}}
  ],
  "oneOf": [
    {"properties": {"classification": {"const": "OK"}, "decision": {"const": "proceed"}, "evidence": {"items": {"properties": {"status": {"const": "pass"}}}}}},
    {"properties": {"classification": {"const": "PARCIAL"}, "decision": {"const": "fix-and-retry"}}},
    {"properties": {"classification": {"const": "PARCIAL"}, "decision": {"const": "escalate"}}},
    {"properties": {"classification": {"const": "BLOQ"}, "decision": {"const": "escalate"}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
