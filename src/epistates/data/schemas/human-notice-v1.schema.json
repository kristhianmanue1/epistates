{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistates.dev/schemas/human-notice-v1.schema.json",
  "title": "Epistates human notice v1",
  "description": "Structural descriptor for epistates/human-notice/v1. validation_scope: structural_only. The normative validator is epistates.human_notice.validate_human_notice; the normative binding is validate_human_notice_binding (not expressed here). Closed human notice: only identity and a cataloged event. Enables inspection, does not grant authority. Does not carry prompt, command or free text. $id is an opaque identifier, never a URL to download.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "run_id", "attempt_id", "task_card_digest", "adapter_digest", "dispatch_receipt_digest", "adapter_id", "session_name", "event_id", "notified_at", "max_dispatch_age_seconds"],
  "properties": {
    "schema": {"const": "epistates/human-notice/v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "task_card_digest": {"$ref": "#/$defs/digest"},
    "adapter_digest": {"$ref": "#/$defs/digest"},
    "dispatch_receipt_digest": {"$ref": "#/$defs/digest"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "session_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "event_id": {"enum": ["external_completion"]},
    "notified_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "max_dispatch_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 7200}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
