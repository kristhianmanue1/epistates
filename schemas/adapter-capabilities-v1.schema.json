{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistates.dev/schemas/adapter-capabilities-v1.schema.json",
  "title": "Epistates adapter capabilities v1",
  "description": "Declaracion neutral de identidad y capacidades de un adaptador. Declara, no prueba que este implementado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter_id", "version", "platforms", "capabilities"],
  "properties": {
    "schema": {"const": "epistates/adapter-capabilities/v1"},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"const": "v1"},
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["darwin", "linux"]}
    },
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["dispatch_literal", "observe_session", "capture_once"]}
    }
  }
}
